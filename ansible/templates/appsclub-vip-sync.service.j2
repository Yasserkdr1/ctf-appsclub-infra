[Unit]
Description=AppsClub CTF team-owned challenge VIP reconciliation
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/bin/python3 /usr/local/libexec/appsclub-vip-controller.py --registry /etc/appsclub-vip/vpn-team-peers.json --apply
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/appsclub-vip /run
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
