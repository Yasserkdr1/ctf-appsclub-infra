[Unit]
Description=AppsClub VPN self-service UNIX broker
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
RuntimeDirectory=appsclub-vpn
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/libexec/appsclub-vpn-broker.py serve
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/appsclub-vpn /var/lib/appsclub-vip /run/appsclub-vpn /run/lock
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
