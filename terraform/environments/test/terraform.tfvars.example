# Copy to terraform.tfvars, then edit. Do not commit terraform.tfvars.
# Your own public IP, not Azure Cloud Shell's public IP.
admin_cidr = "REPLACE_WITH_YOUR_PUBLIC_IP/32"

# Paste content of ~/.ssh/id_ed25519.pub. NEVER use the private key.
admin_ssh_public_key = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"

# SAFE DEFAULT: network only. Set true only after cost and security review.
deploy_vms = false
